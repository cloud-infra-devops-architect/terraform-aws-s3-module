        <mxCell id="title" value="🪣 terraform-aws-s3-module — Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry" /></mxCell>
